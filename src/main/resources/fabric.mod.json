{
  "schemaVersion": 1,
  "id": "wandererz",
  "version": "${version}",
  "name": "WandererZ",
  "description": "Adds player levels, now with integrated Jobs, RPG Difficulty, Tiered, Party, food spoilage and nutrition systems",
  "authors": [
    "Globox_Z",
    "xR4YM0ND"
  ],
  "contact": {
    "homepage": "https://github.com/Atlasroar/LevelZ",
    "sources": "https://github.com/Atlasroar/LevelZ",
    "issues": "https://github.com/Atlasroar/LevelZ/issues"
  },
  "license": "GPLv3",
  "icon": "assets/wandererz/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.wandererz.WandererzMain",
      "net.jobsaddon.JobsAddonMain",
      "net.rpgdifficulty.RpgDifficultyMain",
      "draylar.tiered.Tiered",
      "net.partyaddon.PartyAddonMain",
      "net.spoiledz.SpoiledZMain",
      "net.nutritionz.NutritionMain"
    ],
    "client": [
      "net.wandererz.WandererzClient",
      "net.jobsaddon.JobsAddonClient",
      "net.rpgdifficulty.RpgDifficultyClient",
      "draylar.tiered.TieredClient",
      "net.partyaddon.PartyAddonClient",
      "net.spoiledz.SpoiledZClient",
      "net.nutritionz.NutritionClient"
    ],
    "modmenu": [
      "net.wandererz.config.ModMenuIntegration"
    ],
    "emi": [
      "net.wandererz.compat.WandererzEmiPlugin"
    ],
    "rei_client": [
      "net.wandererz.compat.WandererzReiPlugin"
    ],
    "jade": [
      "net.wandererz.waila.LevelJadePlugin"
    ]
  },
  "mixins": [
    "wandererz.mixins.json",
    "jobsaddon.mixins.json",
    "rpgdifficulty.mixins.json",
    "tiered.mixins.json",
    "partyaddon.mixins.json",
    "spoiledz.mixins.json",
    "nutritionz.mixins.json"
  ],
  "depends": {
    "java": ">=17",
    "minecraft": ">=${minecraft_version}",
    "fabric-api": ">=${fabric_version}",
    "fabricloader": ">=${loader_version}",
    "cloth-config2": ">=${cloth_config_version}",
    "libz": "*",
    "autotag-convention": ">=${autotag_version}"
  },
  "suggests": {
    "modmenu": "*",
    "seasons": "*",
    "sereneseasons": "*",
    "glitchcore": "*"
  },
  "breaks": {
    "nutritionz": "*"
  },
  "custom": {
    "waila:plugins": {
      "id": "wandererz:plugin",
      "environment": "client",
      "initializer": "net.wandererz.waila.LevelWailaPlugin"
    }
  }
}